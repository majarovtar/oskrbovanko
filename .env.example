DATABASE_URL=postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres
ADMIN_API_KEY=<random secret>
SERVICE_API_KEY=<random secret>
JWT_SECRET=<random secret>
AZURE_VOICELIVE_ENDPOINT=
AZURE_VOICELIVE_API_KEY=
VOICELIVE_MODEL=
VOICELIVE_VOICE=
CORS_ORIGINS=
RESEND_API_KEY=<resend api key>
CRITICAL_CALL_EMAIL_TO=<recipient email, comma-separated for several>
CRITICAL_CALL_EMAIL_FROM=onboarding@resend.dev
# Infobip Voice - see https://www.infobip.com/docs/voice-and-video/calls
INFOBIP_API_KEY=<infobip api key, sent as "Authorization: App <key>">
INFOBIP_BASE_URL=<your account base url, e.g. https://xxxxxx.api.infobip.com>
INFOBIP_APPLICATION_ID=<Calls application id from the Infobip portal>
INFOBIP_CALLER_NUMBER=<leased voice number, e.g. 38640123456 - leave empty to use Infobip's trial sender>
# Public wss:// URL Infobip's media stream can reach (ngrok during local dev).
INFOBIP_PUBLIC_WS_BASE_URL=<e.g. wss://your-tunnel.ngrok-free.app>
SPO2_MIN=
PULSE_MIN=
PULSE_MAX=
ANSWER_WAIT_MS=
